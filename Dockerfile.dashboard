# TaurusMQ Dashboard — Next.js UI (PORT, default 3000).
# Single public entrypoint: /api/* and /ws are rewritten (same-origin)
# to the `api` service, so the browser only ever talks to this container.
FROM node:22-alpine AS build

WORKDIR /app/dashboard

COPY dashboard/package.json dashboard/package-lock.json* ./
RUN npm ci

COPY dashboard/ ./

# Build-time API target for next.config.ts rewrites() (evaluated at build).
# Compose passes TAURUSMQ_API_URL=http://api:4000; local default = localhost.
ARG TAURUSMQ_API_URL=http://localhost:4000
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:22-alpine

WORKDIR /app/dashboard
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

COPY --from=build /app/dashboard/package.json ./
COPY --from=build /app/dashboard/package-lock.json* ./
RUN npm ci --omit=dev

COPY --from=build /app/dashboard/.next ./.next
COPY --from=build /app/dashboard/public ./public
COPY --from=build /app/dashboard/next.config.ts ./next.config.ts

EXPOSE 3000
ENV PORT=3000

CMD ["npm", "start"]
